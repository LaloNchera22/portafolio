# ============================================================================
# Runinback — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env (it is git-ignored). NEVER put the service-role key
# in any client file — it belongs only in Supabase Edge Function secrets.
# ============================================================================

# --- Public (safe to expose in the browser) --------------------------------
# Set these two in Vercel → Settings → Environment Variables (Production +
# Preview). The static site reads them at runtime from the /api/config endpoint
# (api/config.js) — they are never hardcoded in the repo. The anon key is
# designed to be public; Row Level Security is what keeps data safe, not the
# secrecy of this key.
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"
# Flip rcoin top-ups to Stripe Checkout (test mode). Leave unset/false and the
# console keeps using the instant test RPC. Set to "true" once the Stripe
# secrets below are configured in Supabase.
STRIPE_ENABLED="false"

# --- Server-only secrets (Edge Functions / backend) ------------------------
# Set with:  supabase secrets set ALLOWED_ORIGIN=...
# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# RESERVED names that Supabase injects into every Edge Function automatically —
# you cannot (and need not) set them via `supabase secrets set`. The service
# role bypasses RLS — treat it like a root password; it never leaves the server.

# Origin allowed to call the Edge Functions (locks down CORS + Steam redirects).
# Also used as the base URL Stripe returns the buyer to after checkout.
ALLOWED_ORIGIN="https://runinback.com"

# --- Stripe (rcoin top-ups) — TEST MODE ------------------------------------
# Use Stripe *test* keys only. No real money moves until legal review clears
# rcoin. Set both with:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY  : Stripe → Developers → API keys (Secret key, test mode).
# STRIPE_WEBHOOK_SECRET : the signing secret Stripe shows when you add the
#   webhook endpoint  https://YOUR-ref.supabase.co/functions/v1/stripe-webhook
#   subscribed to the event  checkout.session.completed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Social sign-in --------------------------------------------------------
# Google / GitHub / Apple are enabled in the Supabase dashboard
# (Authentication → Providers) with each provider's client id + secret — they
# do NOT go here. Steam uses OpenID and needs no secret; a Steam Web API key is
# OPTIONAL and only used to show the player's name/avatar:
#   supabase secrets set STEAM_WEB_API_KEY=...
STEAM_WEB_API_KEY=""
